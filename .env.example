# SUGAM-AI Environment Configuration
PORT=5001
NODE_ENV=development

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:5001

# Authentication Secrets
JWT_SECRET=sugam_ai_super_secret_jwt_key_2026_bis_compliance_platform
TOKEN_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# LIVE AI (real-time web search) CONFIGURATION
# ---------------------------------------------------------------------------
# Set ONE of these to enable real-time, web-search-grounded BIS answers.
# If both are empty, the app automatically falls back to the local static
# BIS reference engine (works, but not real-time / may be outdated).
#
# GEMINI_API_KEY: get a free key at https://aistudio.google.com/apikey
#   -> Uses Gemini's built-in Google Search grounding tool for live answers.
# OPENAI_API_KEY: get a key at https://platform.openai.com/api-keys
#   -> Uses OpenAI's Responses API hosted web_search tool.
# If both are set, Gemini is tried first and OpenAI is the fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model name override (optional).
# Gemini default: gemini-2.5-flash | OpenAI default: gpt-4.1-mini
AI_MODEL=

# Optional Google OAuth Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
